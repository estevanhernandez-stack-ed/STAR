# Copy to .env and fill in. NEVER commit .env.

# Gemini via Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Parallel (https://platform.parallel.ai)
PARALLEL_API_KEY=

# Models (override if desired)
STAR_FAST_MODEL=gemini-3.6-flash
STAR_SMART_MODEL=gemini-3.6-flash

# Cost guardrail: max Parallel searches per room build
STAR_MAX_SEARCHES_PER_BUILD=30

# Google Cloud project (Phase 2+). Firestore + Firebase Auth + Cloud Run.
#
# The Firebase web API key is public by design: it identifies the project to the
# browser, it does not authenticate anyone, and /config.js serves it to every
# visitor. It is checked in here for the same reason.
#
# Where security actually comes from, corrected 2026-08-10. This comment used to
# say "Auth + Firestore rules", and the second half was never true of this
# project: NO Firestore ruleset is deployed, deliberately. With none deployed
# Firestore denies all client access outright, so the server holding Application
# Default Credentials is the only path to the data and every read is scoped by
# uid in star/store.py. That is one boundary rather than two, and deploying
# permissive test-mode rules would silently void it. A comment naming a control
# this project does not have is the same defect class the Phase 3 review kept
# finding in copy, so it is fixed here rather than softened.
GOOGLE_CLOUD_PROJECT=star-research-dept
FIREBASE_PROJECT_ID=star-research-dept
FIREBASE_API_KEY=AIzaSyDQHAdqVNx1nFsOeF-KpB5mMaf123QSh1U
FIREBASE_AUTH_DOMAIN=star-research-dept.firebaseapp.com
FIREBASE_APP_ID=1:390753828501:web:41820d8fa044c08993259c

# Google account linking (cycle #19). Public identifier, like the key above.
# Deliberately NOT in config.validate_env(): that function fails the boot on
# anything whose absence would be silent, and this one's absence is loud by
# construction — /config.js serves "", the card renders linking as unavailable
# and says why, and every other path still works.
#
# Its OAuth client must carry BOTH of these as Authorized redirect URIs, in the
# "Authorized redirect URIs" box and not the "Authorized JavaScript origins" box
# above it, which rejects a trailing slash and is not what OAuth matches on:
#   https://star-390753828501.us-central1.run.app/
#   http://localhost:8000/
# Skipping the localhost entry works in production and looks like a broken
# button on a laptop.
GOOGLE_OAUTH_CLIENT_ID=

# Pipeline B — Script Check. All three have working defaults; set only to tune.
# A check is not a build: 8 searches against a build's 30, and a wall-clock
# ceiling well under Cloud Run's 900s request timeout.
STAR_MAX_SCENE_CHARS=8000
STAR_MAX_SEARCHES_PER_CHECK=8
STAR_CHECK_TIMEOUT_SECONDS=180

# MCP door. Comma-separated. Defaults to the deployed URL plus localhost:8000;
# set only if the service answers on another origin.
STAR_MCP_ALLOWED_ORIGINS=
