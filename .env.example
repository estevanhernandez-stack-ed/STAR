# Copy to .env and fill in. NEVER commit .env.

# Gemini via Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Parallel (https://platform.parallel.ai)
PARALLEL_API_KEY=

# Models (override if desired)
STAR_FAST_MODEL=gemini-3.6-flash
STAR_SMART_MODEL=gemini-3.6-flash

# Cost guardrail: max Parallel searches per room build
STAR_MAX_SEARCHES_PER_BUILD=30

# Google Cloud project (Phase 2+). Firestore + Firebase Auth + Cloud Run.
# The Firebase web API key is public by design — it identifies the project to
# the browser and is not a secret. Security comes from Auth + Firestore rules.
GOOGLE_CLOUD_PROJECT=star-research-dept
FIREBASE_PROJECT_ID=star-research-dept
FIREBASE_API_KEY=AIzaSyDQHAdqVNx1nFsOeF-KpB5mMaf123QSh1U
FIREBASE_AUTH_DOMAIN=star-research-dept.firebaseapp.com
FIREBASE_APP_ID=1:390753828501:web:41820d8fa044c08993259c
