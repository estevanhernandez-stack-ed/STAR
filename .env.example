# Copy to .env and fill in. NEVER commit .env.

# Gemini via Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Parallel (https://platform.parallel.ai)
PARALLEL_API_KEY=

# Models (override if desired)
STAR_FAST_MODEL=gemini-flash-latest
STAR_SMART_MODEL=gemini-flash-latest

# Cost guardrail: max Parallel searches per room build
STAR_MAX_SEARCHES_PER_BUILD=30
