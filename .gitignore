# Environment
.env
.venv/
venv/

# Browser-automation artifacts: screenshots, snapshots, console logs.
.playwright-mcp/
star-*.png

# vibe-glow capture evidence. Every round re-shoots the same surface names, so
# these are regenerated rather than edited, and a committed round would only
# ever conflict with the next one. The campaign pointer (.vibe-glow/state.json)
# and the measuring-stick doc under docs/design/ are the durable parts.
docs/ui-evidence/

# Agent tooling — .mcp.json carries a live bearer token in an
# Authorization header. Never commit it; the repo is public.
.mcp.json
.claude/
.superpowers/

# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# ADK / tooling
.adk/
.pytest_cache/

# vibe-access: config.json is durable, secret-free, and describes the app's
# agent surface, so it belongs in the repo. Everything else under .vibe-access/
# is per-run state — scan inventories, verify results, scaffold backups — which
# is regenerated by the next `:scan` and would only ever conflict.
.vibe-access/*
!.vibe-access/config.json

# vibe-doc: same split as .vibe-access above. intake-profile.json is durable,
# secret-free, hand-written context that describes what this project is, and it
# seeds the next scan. state.json is per-run output — artifact inventory,
# classification, gap tiers — regenerated by the next `:scan` and nothing but a
# conflict if committed.
.vibe-doc/*
!.vibe-doc/intake-profile.json

# Frontend (week 2)
node_modules/
web/dist/

# OS / editor
.DS_Store
Thumbs.db

# ElevenLabs credentials (the tiktok-video-maker skill reads this next to a manifest or in ~)
.elevenlabs.json

# Video, voiceover, stills and cards for the Devpost submission (large binaries, kept local)
submission/
